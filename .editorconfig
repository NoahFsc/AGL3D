root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{json,uss,uxml,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.{ts,tsx,mts,js,mjs,cjs,vue,css,html}]
indent_style = space
indent_size = 2
max_line_length = 100
